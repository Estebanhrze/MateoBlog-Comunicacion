---
const base = import.meta.env.BASE_URL;
---

<div>
  <img src={`${base}assets/mateoPerfilPRO.png`} alt="Foto de perfil de Mateo">
  <p>
    Hola, soy <strong>Mateo</strong>. Soy un ingeniero comercial que ayuda a pequeños negocios y
    empresas a optimizar sus procesos.
  </p>
</div>

<style>
  div {
    align-items: center;
    display: flex;
  }

  img {
    width: 100px;
    height: 100px;
    border-radius: 100px;
    display: block;
    margin-right: 20px;
  }

  p {
    font-size: 1.125rem;
  }
</style>
